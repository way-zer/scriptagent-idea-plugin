<idea-plugin>
    <id>cf.wayzer.scriptAgent.ideaPlugin</id>
    <name>ScriptAgent</name>
    <vendor email="himc.wicp@gmail.com">WayZer</vendor>

    <description><![CDATA[
     Idea Plugin for ScriptAgent scripting support.
  ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileBasedIndex implementation="cf.wayzer.scriptagent.ideaplugin.index.ScriptIndexer"/>

        <postStartupActivity implementation="cf.wayzer.scriptagent.ideaplugin.ScriptAgentStartup"/>
        <toolWindow id="SA Scripts" anchor="bottom" secondary="true"
                    factoryClass="cf.wayzer.scriptagent.ideaplugin.toolwindow.ScriptIndexToolWindow"/>
    </extensions>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
        <scriptDefinitionsProvider implementation="cf.wayzer.scriptagent.ideaplugin.SAScriptProvider"/>
        <k2IdeScriptAdditionalIdeaDependenciesProvider
                implementation="cf.wayzer.scriptagent.ideaplugin.SAScriptDependenciesProvider"/>
        <fir.extensions.firExtensionRegistrar implementation="cf.wayzer.scriptAgent.impl.loader.kcp.MyFirRegistrar"/>
    </extensions>
</idea-plugin>
