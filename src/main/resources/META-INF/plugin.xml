<idea-plugin>
    <id>cf.wayzer.scriptAgent.ideaPlugin</id>
    <name>ScriptAgent</name>
    <vendor email="himc.wicp@gmail.com">WayZer</vendor>

    <description><![CDATA[
     Idea Plugin for ScriptAgent scripting support.
  ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <actions>
        <group id="ScriptAgent.DownloadDepsActionGroup">
            <action id="ScriptAgent.DownloadDeps"
                    class="cf.wayzer.scriptagent.ideaplugin.maven.DownloadDepsAction"/>
        </group>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <fileBasedIndex implementation="cf.wayzer.scriptagent.ideaplugin.index.ScriptIndexer"/>

        <postStartupActivity implementation="cf.wayzer.scriptagent.ideaplugin.ScriptAgentStartup"/>
        <toolWindow id="SA Scripts" anchor="bottom" secondary="true"
                    factoryClass="cf.wayzer.scriptagent.ideaplugin.toolwindow.ScriptIndexToolWindow"/>

        <editorFloatingToolbarProvider
                id="ScriptAgent.DepsFloatingToolbarProvider"
                order="after ExternalSystem.ProjectRefreshFloatingProvider"
                implementation="cf.wayzer.scriptagent.ideaplugin.maven.DepsFloatingToolbarProvider"/>

        <notificationGroup id="ScriptAgent" displayType="BALLOON"/>

        <attachSourcesProvider implementation="cf.wayzer.scriptagent.ideaplugin.maven.SAAttachSourcesProvider"/>

        <psi.referenceContributor language="kotlin"
                implementation="cf.wayzer.scriptagent.ideaplugin.navigation.ScriptDependsReferenceContributor"/>
        <annotator language="kotlin"
                implementationClass="cf.wayzer.scriptagent.ideaplugin.navigation.ScriptAnnotationAnnotator"/>
        <codeInsight.lineMarkerProvider language="kotlin"
                implementationClass="cf.wayzer.scriptagent.ideaplugin.navigation.ExportLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="kotlin"
                implementationClass="cf.wayzer.scriptagent.ideaplugin.stub.StubRefreshLineMarkerProvider"/>
    </extensions>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
        <scriptDefinitionsProvider implementation="cf.wayzer.scriptagent.ideaplugin.SAScriptProvider"/>
        <scriptAdditionalIdeaDependenciesProvider
                implementation="cf.wayzer.scriptagent.ideaplugin.SAScriptDependenciesProvider"/>
        <fir.extensions.firExtensionRegistrar implementation="cf.wayzer.scriptAgent.impl.loader.kcp.MyFirRegistrar"/>
        <kaResolveExtensionProvider implementation="cf.wayzer.scriptagent.ideaplugin.stub.SAResolveExtensionProvider"/>
    </extensions>
</idea-plugin>
